              "icon": "globe",
              "label": "Public tunnel (localhost.run)",
              "meta": "asks for port",
              "type": "shell",
              "terminal": "Tunnel",
              "command": "read -rp \"Local port: \" p; [[ $p =~ ^[0-9]+$ ]] || { echo \"Invalid port.\"; exit 1; }; ssh -R 80:localhost:$p -i ~/.ssh/localhost_run localhost.run",
              "local": true
            }
          ]
