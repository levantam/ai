{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Tami extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode", "${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/vscode/out/**/*.js"],
      "preLaunchTask": "tami: compile"
    }
  ]
}
